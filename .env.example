# Only DATABASE_URL is required. Deploy, open the app, and the setup page asks for everything else
# (passphrase, banks, your name) and creates the signing secret, SMS token and notification keys.
# Any value below that you set in the environment wins over the one the setup page saved.

# Postgres (Neon recommended). Pooled connection string, with sslmode=require.
DATABASE_URL=

# --- Optional overrides (leave empty to let the setup page handle them) ---
# Leave empty for a new install, so the owner picks a passphrase in the setup wizard. If set, the setup page is skipped.
# scrypt hash of the passphrase: npm run hash-password -- 'your long passphrase'.
ADMIN_PASSWORD_HASH=
# 32+ random characters. Signs session cookies, CSRF tokens and SMS fingerprints.
SESSION_SECRET=
# 32+ random characters. Bearer token the iPhone Shortcut sends to POST /api/sms.
SMS_INGEST_TOKEN=
# Set to "false" to send every parsed SMS to the review inbox.
SMS_AUTO_IMPORT=true
# Extra comma-separated sender IDs to trust, as if they were your first bank.
SMS_TRUSTED_SENDERS=
# Your name as the bank prints it (also editable in Settings).
SMS_OWN_NAMES=
# Web push keys for review notifications: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Optional: nightly backups to Google Drive ---
# 32+ random characters. Vercel Cron sends it to /api/cron/backup.
CRON_SECRET=
# Google OAuth client for Drive backups (drive.file scope).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: email codes when signing in on a new device ---
# API key from resend.com. With it set, Settings → Sign-in can turn on email codes.
RESEND_API_KEY=
# Sender, e.g. "Mizan <mizan@yourdomain.com>" (a domain verified in Resend). Left empty, Resend's test sender is used,
# which only delivers to the email address your Resend account was made with.
EMAIL_FROM=
# Set to "off" to stop asking for email codes (a way back in if email ever breaks and the recovery codes are lost).
EMAIL_CODES=
