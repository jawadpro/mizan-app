# Postgres (Neon recommended). Pooled connection string, with sslmode=require.
DATABASE_URL=
# scrypt hash of the workspace passphrase: npm run hash-password -- 'your long passphrase'
ADMIN_PASSWORD_HASH=
# 32+ random characters. Signs session cookies, CSRF tokens and SMS fingerprints.
SESSION_SECRET=
# 32+ random characters. Bearer token the iPhone Shortcut sends to POST /api/sms.
SMS_INGEST_TOKEN=
# Optional: set to "false" to send every parsed SMS to the review inbox.
SMS_AUTO_IMPORT=true
# Optional: extra comma-separated sender IDs to trust besides "MCB".
SMS_TRUSTED_SENDERS=
# Optional: your name as the bank prints it, so transfers between your own accounts are recognised.
SMS_OWN_NAMES=
# Web push keys for review notifications: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# 32+ random characters. Vercel Cron sends it to /api/cron/backup.
CRON_SECRET=
# Google OAuth client for Drive backups (drive.file scope).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
